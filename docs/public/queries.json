        "    author_id: i64,",
        "}",
        "",
        "#[derive(Entity)]",
        "#[tank(schema = \"library\", name = \"authors\")]",
        "struct Author {",
        "    #[tank(primary_key)]",
        "    id: i64,",
        "    name: String,",
        "}",
        "",
        "let rows = connection",
        "    .fetch(",
        "        QueryBuilder::new()",
        "            .select(cols!(Book::title, Author::name))",
        "            .from(join!(",
        "                Book JOIN Author",
        "                    ON Book::author_id == Author::id",
