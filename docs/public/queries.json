    {
      "file": "left_join.rs",
      "rust": [
        "use tank::{Entity, QueryBuilder, cols, expr, join};",
        "use rust_decimal::Decimal;",
        "use uuid::Uuid;",
        "",
        "#[derive(Entity)]",
        "#[tank(schema = \"shop\", name = \"orders\")]",
        "struct Order {",
        "    #[tank(primary_key)]",
        "    id: Uuid,",
        "    customer_id: Uuid,",
        "    total: Decimal,",
        "}",
        "",
        "#[derive(Entity)]",
        "#[tank(schema = \"shop\", name = \"customers\")]",
        "struct Customer {",
        "    #[tank(primary_key)]",
        "    id: Uuid,",
        "    name: String,",
        "}",
        "",
        "let rows = connection",
        "    .fetch(",
        "        QueryBuilder::new()",
        "            .select(cols!(O.total, C.name as customer))",
        "            .from(join!(",
        "                Order O LEFT JOIN Customer C",
        "                    ON O::customer_id == C::id",
        "            ))",
        "            .where_expr(expr!(O::total > 100.0))",
        "            .order_by(cols!(O::total DESC))",
        "            .build(&connection.driver()),",
        "    )",
        ".try_collect::<Vec<_>>()",
        ".await?;"
      ],
      "Postgres": "SELECT O.\"total\", C.\"name\" AS customer\nFROM \"shop\".\"orders\" O\nLEFT JOIN \"shop\".\"customers\" C\n    ON O.\"customer_id\" = C.\"id\"\nWHERE O.\"total\" > 100.0\nORDER BY O.\"total\" DESC;",
      "MySQL": "SELECT O.`total`, C.`name` AS customer\nFROM `shop`.`orders` O\nLEFT JOIN `shop`.`customers` C\n    ON O.`customer_id` = C.`id`\nWHERE O.`total` > 100.0\nORDER BY O.`total` DESC;",
      "SQLite": "SELECT O.\"total\", C.\"name\" AS customer\nFROM \"orders\" O\nLEFT JOIN \"customers\" C\n    ON O.\"customer_id\" = C.\"id\"\nWHERE O.\"total\" > 100.0\nORDER BY O.\"total\" DESC;"
    },
