      "MySQL": "SELECT `library`.`books`.`title`, `library`.`authors`.`name`\nFROM `library`.`books`\nJOIN `library`.`authors`\n    ON `library`.`books`.`author_id` = `library`.`authors`.`id`;",
      "SQLite": "SELECT \"books\".\"title\", \"authors\".\"name\"\nFROM \"books\"\nJOIN \"authors\"\n    ON \"books\".\"author_id\" = \"authors\".\"id\";"
