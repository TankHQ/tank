    {
      "file": "group_by.rs",
      "rust": [
        "use tank::{Entity, QueryBuilder, cols};",
        "use rust_decimal::Decimal;",
        "",
        "#[derive(Entity)]",
        "#[tank(schema = \"trading\", name = \"trades\")]",
        "struct Trade {",
        "    #[tank(primary_key)]",
        "    id: i64,",
        "    symbol: String,",
        "    venue: String,",
        "    price: Decimal,",
        "    quantity: u32,",
        "}",
        "",
        "let by_symbol: Vec<Trade> = connection",
        "    .fetch(",
        "        QueryBuilder::new()",
        "            .select(cols!(",
        "                Trade::symbol,",
        "                COUNT(*) as fills,",
        "                SUM(Trade::quantity) as volume,",
        "            ))",
        "            .from(Trade::table())",
        "            .group_by([Trade::symbol])",
        "            .order_by(cols!(Trade::symbol ASC))",
        "            .build(&connection.driver()),",
        "    )",
        ".try_collect()",
        ".await?;"
      ],
      "Postgres": "SELECT \"symbol\", COUNT(*) AS fills, SUM(\"quantity\") AS volume\nFROM \"trading\".\"trades\"\nGROUP BY \"symbol\"\nORDER BY \"symbol\" ASC;",
      "MySQL": "SELECT `symbol`, COUNT(*) AS fills, SUM(`quantity`) AS volume\nFROM `trading`.`trades`\nGROUP BY `symbol`\nORDER BY `symbol` ASC;",
      "SQLite": "SELECT \"symbol\", COUNT(*) AS fills, SUM(\"quantity\") AS volume\nFROM \"trades\"\nGROUP BY \"symbol\"\nORDER BY \"symbol\" ASC;"
    },
    {
      "file": "having.rs",
      "rust": [
        "use tank::{Entity, QueryBuilder, cols, expr};",
        "",
        "#[derive(Entity)]",
        "#[tank(schema = \"ops\", name = \"events\")]",
        "struct Event {",
        "    #[tank(primary_key)]",
        "    id: i64,",
        "    source: String,",
        "    level: String,",
        "    count: u32,",
        "}",
        "",
        "let noisy: Vec<Event> = connection",
        "    .fetch(",
        "        QueryBuilder::new()",
        "            .select(cols!(Event::level, SUM(Event::count) as total))",
        "            .from(Event::table())",
        "            .group_by([Event::level])",
        "            .having(expr!(SUM(Event::count) > 1000))",
        "            .order_by(cols!(Event::level ASC))",
        "            .build(&connection.driver()),",
        "    )",
        ".try_collect()",
        ".await?;"
      ],
      "Postgres": "SELECT \"level\", SUM(\"count\") AS total\nFROM \"ops\".\"events\"\nGROUP BY \"level\"\nHAVING SUM(\"count\") > 1000\nORDER BY \"level\" ASC;",
      "MySQL": "SELECT `level`, SUM(`count`) AS total\nFROM `ops`.`events`\nGROUP BY `level`\nHAVING SUM(`count`) > 1000\nORDER BY `level` ASC;",
      "SQLite": "SELECT \"level\", SUM(\"count\") AS total\nFROM \"events\"\nGROUP BY \"level\"\nHAVING SUM(\"count\") > 1000\nORDER BY \"level\" ASC;"
    },
