    {
      "file": "query_builder.rs",
      "rust": [
        "use tank::{Entity, QueryBuilder, cols, expr};",
        "",
        "#[derive(Entity)]",
        "#[tank(schema = \"army\", name = \"readings\")]",
        "struct Reading {",
        "    #[tank(primary_key)]",
        "    id: i64,",
        "    sensor: String,",
        "    celsius: f32,",
        "    humidity: f32,",
        "}",
        "",
        "let hottest: Vec<Reading> = connection",
        "    .fetch(",
        "        QueryBuilder::new()",
        "            .select(cols!(Reading::sensor, Reading::celsius))",
        "            .from(Reading::table())",
        "            .where_expr(expr!(Reading::celsius > 30.0))",
        "            .order_by(cols!(Reading::celsius DESC))",
        "            .limit(Some(10))",
        "            .build(&connection.driver()),",
        "    )",
        ".try_collect()",
        ".await?;"
      ],
      "Postgres": "SELECT \"sensor\", \"celsius\"\nFROM \"army\".\"readings\"\nWHERE \"celsius\" > 30.0\nORDER BY \"celsius\" DESC\nLIMIT 10;",
      "MySQL": "SELECT `sensor`, `celsius`\nFROM `army`.`readings`\nWHERE `celsius` > 30.0\nORDER BY `celsius` DESC\nLIMIT 10;",
      "SQLite": "SELECT \"sensor\", \"celsius\"\nFROM \"readings\"\nWHERE \"celsius\" > 30.0\nORDER BY \"celsius\" DESC\nLIMIT 10;"
